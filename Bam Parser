#Requires -RunAsAdministrator
#Requires -Version 5.1
<#
.SYNOPSIS
    BAM (Background Activity Moderator) Forensic Parser - v2.1
.DESCRIPTION
    Extracts program execution evidence from BAM registry keys with
    volume path resolution, Authenticode checks, filtering, and export.
.NOTES
    DFIR / execution-timeline analysis utility
    Compatible: Windows 10 1709+ / Windows 11

    CHANGELOG (v2.0 -> v2.1)
    - Removed dead/broken volume-map code path (Get-VolumeMap + Win32.Kernel32
      type were defined but never called, and the Set-Alias used to reference
      the type didn't actually work - Set-Alias aliases commands, not types).
      There is now a single, actually-used volume-mapping routine.
    - Get-TimezoneInfo no longer assumes ActiveTimeBias exists; falls back to
      0 and warns instead of letting a later AddMinutes($null) call throw.
    - Export-Results now excludes the internal SortTime sort key so CSV/JSON
      output matches what's shown in the grid/pipeline (previously leaked
      through as an extra column).
    - Registry values are now read once per SID key via a single
      Get-ItemProperty call instead of one call per value - much faster on
      accounts with a long BAM history.
    - $ErrorActionPreference left at Continue by default; the handful of
      operations that are *expected* to fail sometimes (hashing a deleted
      file, translating an orphaned SID, etc.) use explicit try/catch
      instead of relying on a blanket SilentlyContinue that could hide a
      real problem elsewhere in the script.
    - Minor: progress output while scanning, safer AppX/package detection.
.EXAMPLE
    .\BAM-Parser.ps1
.EXAMPLE
    .\BAM-Parser.ps1 -ExportPath C:\Evidence -Format CSV,JSON -DaysBack 7
.EXAMPLE
    .\BAM-Parser.ps1 -Filter "*.exe" -UnsignedOnly -NoGrid
#>

[CmdletBinding()]
param(
    [string]$ExportPath,
    [ValidateSet('CSV', 'JSON', 'HTML', 'All')]
    [string[]]$Format = @('CSV'),
    [int]$DaysBack = 0,
    [string]$Filter = '*',
    [switch]$UnsignedOnly,
    [switch]$NoGrid,
    [switch]$IncludeSystemAccounts,
    [switch]$Quiet
)

$ErrorActionPreference = 'Continue'
$sw = [System.Diagnostics.Stopwatch]::StartNew()

#region Helpers

